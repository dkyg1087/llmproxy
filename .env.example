# Central LLMProxy Configuration

# Cryptographic Master Key for AES-256-GCM API Key Vault (32 characters recommended)
GATEWAY_SECRET_KEY=default_gateway_secret_key_32bytes_change_me!

# Server Execution Port
PORT=8085

# Database File Path
DB_PATH=router.db

# Provider API Keys for Seeding (Optional on startup, can also be added via Admin Dashboard)
GEMINI_API_KEY=your_google_ai_studio_key_here
GROQ_API_KEY=your_groq_cloud_key_here

# BwK Router Bias Weights
GAP_BIAS=2.0
DURATION_BIAS=0.2
USAGE_BIAS=1.0

# Failover Execution Retries
MAX_FAILOVER_RETRIES=3

# Triage LLM Classifier Max Timeout (seconds)
TRIAGE_TIMEOUT_SECONDS=10

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
